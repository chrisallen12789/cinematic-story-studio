{
  "name": "@cinematic-story-studio/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Secure Electron desktop shell for Cinematic Story Studio.",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "assets": "node scripts/generate-assets.mjs",
    "dev": "node scripts/dev.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:packaged": "node scripts/run-packaged-e2e.mjs",
    "test:e2e:packaged:phase3b1-real": "node scripts/run-phase3b1-real-product-e2e.mjs",
    "build": "pnpm run assets && node scripts/build.mjs",
    "package:dir": "pnpm run build && electron-builder --dir --config electron-builder.yml"
  },
  "dependencies": {
    "@cinematic-story-studio/contracts": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.1",
    "eslint": "10.0.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "jsdom": "30.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.12"
  }
}
