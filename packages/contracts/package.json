{
  "name": "@cinematic-story-studio/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Dependency-free shared contracts for Cinematic Story Studio.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./domain": {
      "types": "./dist/domain.d.ts",
      "default": "./dist/domain.js"
    },
    "./runtime-agent": {
      "types": "./dist/runtime-agent.d.ts",
      "default": "./dist/runtime-agent.js"
    },
    "./story-analysis": {
      "types": "./dist/story-analysis.d.ts",
      "default": "./dist/story-analysis.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
